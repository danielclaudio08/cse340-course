<%- include('partials/header') %>

  <main class="registered-users">
    <h1>
      <%= title %>
    </h1>

    <h2>Registered Users</h2>

    <ul>
      <% users.forEach(user=> { %>
        <li>
          <p>
            <strong>Name:</strong>
            <%= user.name %>
          </p>

          <p>
            <strong>Email:</strong>
            <a href="mailto:<%= user.email %>">
              <%= user.email %>
            </a>
          </p>

          <p>
            <strong>Role:</strong>
            <%= user.role_name %>
          </p>
        </li>
        <% }); %>
    </ul>

    <p>
      <a href="/dashboard">Back to Dashboard</a>
    </p>
  </main>

  <%- include('partials/footer') %>