<%- include('partials/header') %>

  <main>

    <h1>
      <%= category.name %>
    </h1>

    <h2>Service Projects</h2>

    <ul>
      <% projects.forEach(project=> { %>
        <li>
          <a href="/project/<%= project.project_id %>" style="text-decoration: none;" class="card-link">
            <%= project.title %>
          </a>
        </li>
        <% }) %>
    </ul>

  </main>

  <%- include('partials/footer') %>