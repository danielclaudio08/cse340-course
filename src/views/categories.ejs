<%- include('partials/header') %>

  <main>
    <h1>
      <%= title %>
    </h1>

    <ul>

      <% categories.forEach(category=> { %>

        <li>
          <a href="/category/<%= category.category_id %>" style="text-decoration: none;" class="card-link">
            <%= category.name %>
          </a>
        </li>

        <% }); %>

    </ul>

  </main>

  <%- include('partials/footer') %>