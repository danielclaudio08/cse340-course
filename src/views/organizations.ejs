<%- include('partials/header') %>
  <main>
    <h1>
      <%= title %>
    </h1>

    <p>Here are a few of our partner organizations:</p>

    <ul>

      <% organizations.forEach(organization=> { %>
        <li>
          <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">

          <strong>
            <a href="/organization/<%= organization.organization_id %>" style="text-decoration: none;">
              <%= organization.name %>
            </a>
          </strong>

          <p>
            <%= organization.description %>
          </p>

          <a href="mailto:<%= organization.contact_email %>">
            <%= organization.contact_email %>
          </a>

        </li>
        <% }); %>

    </ul>
  </main>

  <%- include('partials/footer') %>