<%- include('partials/header') %>

  <main>

    <h1>
      <%= title %>
    </h1>

    <ul>

      <% projects.forEach(project=> { %>

        <li>

          <h2>
            <a href="/project/<%= project.project_id %>" style="text-decoration: none;">
              <%= project.title %>
            </a>
          </h2>

          <p>
            Organization:
            <a href="/organization/<%= project.organization_id %>" style="text-decoration: none;">
              <%= project.organization_name %>
            </a>
          </p>

        </li>

        <% }) %>

    </ul>

  </main>

  <%- include('partials/footer') %>