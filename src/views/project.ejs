<%- include('partials/header') %>

  <main>

    <h1>
      <%= project.title %>
    </h1>

    <p>
      <strong>Description:</strong>
      <%= project.description %>
    </p>

    <p>
      <strong>Date:</strong>
      <%= project.project_date %>
    </p>

    <p>
      <strong>Location:</strong>
      <%= project.location %>
    </p>

    <p>
      <strong>Organization:</strong>

      <a href="/organization/<%= project.organization_id %>" style="text-decoration: none;">
        <%= project.organization_name %>
      </a>
    </p>

    <h3>Categories</h3>

    <ul>
      <% categories.forEach(category=> { %>
        <li>
          <a href="/category/<%= category.category_id %>" style="text-decoration: none;" class="card-link">
            <%= category.name %>
          </a>
        </li>
        <% }) %>
    </ul>

    <% if (isLoggedIn) { %>

      <% if (isVolunteer) { %>

        <p>
          <strong>You are volunteering for this project.</strong>
        </p>

        <p>
          <a href="/project/<%= project.project_id %>/unvolunteer">
            Remove Volunteer Signup
          </a>
        </p>

        <% } else { %>

          <p>
            <a href="/project/<%= project.project_id %>/volunteer">
              Volunteer for this Project
            </a>
          </p>

          <% } %>

            <% } %>

              <% if (user && user.role_name==='admin' ) { %>
                <p>
                  <a href="/assign-categories/<%= project.project_id %>">
                    Edit Categories
                  </a>
                </p>

                <p>
                  <a href="/edit-project/<%= project.project_id %>">
                    Edit Project
                  </a>
                </p>
                <% } %>

  </main>

  <%- include('partials/footer') %>